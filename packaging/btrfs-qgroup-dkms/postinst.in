#!/bin/sh
set -eu

module=btrfs-qgroup
version="@DKMS_VERSION@"

case "${1:-}" in
    configure)
        key="@MOK_KEY@"
        cert_der=/usr/share/btrfs-qgroup-dkms/Rebroad-module-signing-key.der
        test -r "$key"
        cert_fingerprint=$(openssl x509 -inform DER -in "$cert_der" \
            -noout -fingerprint -sha1 | sed 's/^[^=]*=//' | tr -d ':' |
            tr '[:upper:]' '[:lower:]')
        if ! mokutil --list-enrolled 2>/dev/null |
            sed -n 's/^SHA1 Fingerprint: //p' | tr -d ':' |
            tr '[:upper:]' '[:lower:]' |
            grep -Fxq "$cert_fingerprint"; then
            echo "Error: module-signing certificate is not enrolled" >&2
            exit 1
        fi
        for module_dir in /lib/modules/*; do
            test -d "$module_dir" || continue
            kernel=${module_dir##*/}
            if test ! -f "$module_dir/build/Makefile"; then
                echo "Error: headers are missing for installed kernel $kernel" >&2
                exit 1
            fi
            dkms build -m "$module" -v "$version" -k "$kernel"
        done
        for module_dir in /lib/modules/*; do
            test -d "$module_dir" || continue
            kernel=${module_dir##*/}
            dkms install -m "$module" -v "$version" -k "$kernel"
            depmod -a "$kernel"
        done
        for module_dir in /lib/modules/*; do
            test -d "$module_dir" || continue
            kernel=${module_dir##*/}
            if test -e "/boot/initrd.img-$kernel"; then
                update-initramfs -u -k "$kernel"
            else
                update-initramfs -c -k "$kernel"
            fi
        done
        for version_dir in "/var/lib/dkms/$module"/*; do
            test -d "$version_dir" || continue
            old_version=${version_dir##*/}
            test "$old_version" = "$version" && continue
            if test -L "$version_dir/source" &&
                test ! -e "$version_dir/source"; then
                echo "Removing stale DKMS registration $module/$old_version" >&2
                rm -rf -- "$version_dir"
            fi
        done
        ;;
esac

#DEBHELPER#
