#!/bin/bash
# Build signed Btrfs modules in a private DKMS tree before allowing a kernel
# package transaction to install a new kernel.
set -Eeuo pipefail

usage() {
	cat <<'EOF'
Usage: local-btrfs-qgroup-dkms-preflight \
	--module-version VERSION --kernel RELEASE [--kernel RELEASE ...]
	[--output-dir DIR | --prepare-dkms-tree DIR]
	[--source-tree DIR] [--kernel-source RELEASE=DIR] [--certificate FILE]

Builds the configured btrfs-qgroup DKMS source for each exact kernel release,
using installed headers or an explicit staged-header directory, and verifies
signature metadata and vermagic. --output-dir emits one DKMS archive per
release from a private DKMS tree. --prepare-dkms-tree stages the verified
uncompressed build in an already registered DKMS tree for later installation.
EOF
}

die() {
	echo "Error: $*" >&2
	exit 1
}

module=btrfs-qgroup
module_version=
source_tree=/usr/src
certificate=/usr/share/btrfs-qgroup-dkms/Rebroad-module-signing-key.der
output_dir=
prepare_dkms_tree=
declare -a kernels=()
declare -A requested_kernel_sources=()

while (($#)); do
	case $1 in
	--module-version)
		(($# >= 2)) || die "--module-version requires a value"
		module_version=$2
		shift 2
		;;
	--source-tree)
		(($# >= 2)) || die "--source-tree requires a value"
		source_tree=$2
		shift 2
		;;
	--certificate)
		(($# >= 2)) || die "--certificate requires a value"
		certificate=$2
		shift 2
		;;
	--output-dir)
		(($# >= 2)) || die "--output-dir requires a value"
		output_dir=$2
		shift 2
		;;
	--prepare-dkms-tree)
		(($# >= 2)) || die "--prepare-dkms-tree requires a value"
		prepare_dkms_tree=$2
		shift 2
		;;
	--kernel)
		(($# >= 2)) || die "--kernel requires a value"
		kernels+=("$2")
		shift 2
		;;
	--kernel-source)
		(($# >= 2)) || die "--kernel-source requires RELEASE=DIR"
		release=${2%%=*}
		header_dir=${2#*=}
		[[ $release != "$2" && -n $header_dir ]] ||
			die "--kernel-source requires RELEASE=DIR"
		[[ $release =~ ^[A-Za-z0-9.+_-]+$ ]] ||
			die "invalid kernel release in --kernel-source: $release"
		[[ -z ${requested_kernel_sources[$release]+x} ]] ||
			die "duplicate --kernel-source for $release"
		requested_kernel_sources[$release]=$header_dir
		shift 2
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		usage >&2
		die "unknown argument: $1"
		;;
	esac
done

[[ $EUID -eq 0 ]] || die "run as root so DKMS can sign and build modules"
[[ -n $module_version ]] || die "--module-version is required"
if [[ -n $prepare_dkms_tree ]]; then
	[[ -z $output_dir ]] || die "use only one of --output-dir and --prepare-dkms-tree"
else
	[[ -n $output_dir ]] || die "--output-dir is required"
fi
((${#kernels[@]})) || die "at least one --kernel is required"
[[ $module_version =~ ^[A-Za-z0-9.+_-]+$ ]] || die "invalid module version"

for command in dkms modinfo mokutil openssl tar xz realpath; do
	command -v "$command" >/dev/null || die "required command not found: $command"
done

source_tree=$(realpath -e "$source_tree") || die "source tree does not exist"
source_dir=$source_tree/$module-$module_version
[[ -d $source_dir ]] || die "DKMS source directory not found: $source_dir"
[[ -f $source_dir/dkms.conf && -f $source_dir/kernel-source-map ]] ||
	die "DKMS source metadata is incomplete"
grep -Fq "PACKAGE_NAME=\"$module\"" "$source_dir/dkms.conf" ||
	die "dkms.conf package name does not match $module"
grep -Fq "PACKAGE_VERSION=\"$module_version\"" "$source_dir/dkms.conf" ||
	die "dkms.conf package version does not match $module_version"

if [[ -n $output_dir ]]; then
	mkdir -p "$output_dir"
	output_dir=$(realpath -e "$output_dir") || die "cannot resolve output directory"
	repo_root=$(git -C "$(dirname "$(realpath -e "$0")")/.." rev-parse --show-toplevel)
	case "$output_dir/" in
		"$repo_root/"*) die "output directory must be outside the source checkout" ;;
	esac
fi
[[ -f $certificate ]] || die "public signing certificate not found: $certificate"

arch=$(uname -m)
declare -A seen=()
declare -A kernel_sources=()
for release in "${kernels[@]}"; do
	[[ $release =~ ^[A-Za-z0-9.+_-]+$ ]] || die "invalid kernel release: $release"
	[[ -z ${seen[$release]+x} ]] || die "duplicate kernel release: $release"
	seen[$release]=1
	if [[ -n ${requested_kernel_sources[$release]+x} ]]; then
		header_dir=$(realpath -e "${requested_kernel_sources[$release]}") ||
			die "kernel source directory does not exist for $release"
		[[ -f $header_dir/Makefile ]] ||
			die "kernel source directory has no Makefile for $release"
		kernel_sources[$release]=$header_dir
	else
		[[ -e /lib/modules/$release/build/Makefile ]] ||
			die "matching kernel headers are not installed for $release"
	fi
	map_count=$(awk -v wanted="$release" '$1 == wanted { count++ } END { print count + 0 }' \
		"$source_dir/kernel-source-map")
	[[ $map_count -eq 1 ]] || die "source map has $map_count entries for $release"
done
for release in "${!requested_kernel_sources[@]}"; do
	[[ -n ${seen[$release]+x} ]] ||
		die "--kernel-source supplied for unlisted release $release"
done

cert_subject=$(openssl x509 -inform DER -in "$certificate" -noout -subject -nameopt RFC2253)
expected_signer=${cert_subject#subject=CN=}
[[ $expected_signer != "$cert_subject" ]] ||
	die "certificate has no simple CN subject; signer cannot be verified"
mokutil_output=$(mokutil --test-key "$certificate" 2>&1 || true)
[[ $mokutil_output == *"is already enrolled"* ]] ||
	die "module signing certificate is not enrolled with Secure Boot"

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
declare -a archives=()
if [[ -n $output_dir ]]; then
	for release in "${kernels[@]}"; do
		archive=$output_dir/${module}-${module_version}-${release}-${timestamp}.tar
		[[ ! -e $archive ]] || die "refusing to overwrite $archive"
	done
	work=$(mktemp -d "$output_dir/.${module}-preflight.XXXXXX")
else
	work=$(mktemp -d "/var/tmp/${module}-preflight.XXXXXX")
fi
declare -a new_dkms_dirs=()
finish() {
	status=$?
	if ((status == 0)); then
		rm -rf -- "$work"
	else
		if [[ -n $prepare_dkms_tree && -n ${dkms_tree:-} ]]; then
			module_tree=$dkms_tree/$module/$module_version
			for path in "${new_dkms_dirs[@]}"; do
				case "$path/" in
					"$module_tree/"*) rm -rf -- "$path" ;;
					*) echo "Refusing to remove unexpected DKMS path: $path" >&2 ;;
				esac
			done
		fi
		echo "Preflight failed; scratch files retained at $work" >&2
	fi
	exit "$status"
}
trap finish EXIT

install_tree=$work/install-tree
if [[ -n $prepare_dkms_tree ]]; then
	dkms_tree=$(realpath -e "$prepare_dkms_tree") || die "DKMS tree does not exist: $prepare_dkms_tree"
	registered_source=$(realpath -e "$dkms_tree/$module/$module_version/source") ||
		die "$module $module_version is not registered in $dkms_tree"
	[[ $registered_source == "$source_dir" ]] ||
		die "DKMS registration points to an unexpected source tree"
else
	dkms_tree=$work/dkms-tree
	mkdir -p "$dkms_tree"
fi
mkdir -p "$install_tree"
dkms_source_tree=$source_tree
scratch_conf=
if ((${#kernel_sources[@]})); then
	if [[ -z $prepare_dkms_tree ]]; then
		dkms_source_tree=$work/source-tree
		mkdir -p "$dkms_source_tree"
		cp -a "$source_dir" "$dkms_source_tree/$module-$module_version"
		local_conf=$dkms_source_tree/$module-$module_version/dkms.conf
	else
		mkdir -p "$work/source-copy"
		cp -a "$source_dir" "$work/source-copy/$module-$module_version"
		local_conf=$work/source-copy/$module-$module_version/dkms.conf
	fi
	make_target='M=${dkms_tree}/${module}/${module_version}/build'
	make_with_output=$make_target
	make_with_output+=' MO=${dkms_tree}/${module}/${module_version}/build'
	sed -i \
		-e 's|/lib/modules/${kernelver}/build|${kernel_source_dir}|g' \
		-e "s| $make_target| $make_with_output|g" \
		"$local_conf"
	grep -Fq \
		"make -C \${kernel_source_dir} $make_with_output" "$local_conf" ||
		die "could not direct staged-header build outputs into the DKMS tree"
	scratch_conf=$local_conf
fi
if [[ -z $prepare_dkms_tree ]]; then
	dkms add -m "$module" -v "$module_version" \
		--dkmstree "$dkms_tree" --sourcetree "$dkms_source_tree"
fi

for release in "${kernels[@]}"; do
	echo "Building $module $module_version for $release"
	kernel_source_args=()
	config_args=()
	if [[ -n ${kernel_sources[$release]+x} ]]; then
		kernel_source_args+=(--kernelsourcedir "${kernel_sources[$release]}")
	fi
	if [[ -n $scratch_conf ]]; then
		config_args+=(-c "$scratch_conf")
	fi
	if [[ -n $prepare_dkms_tree ]]; then
		release_tree=$dkms_tree/$module/$module_version/$release
		module_dir=$release_tree/$arch/module
		module_file=$module_dir/btrfs.ko
		if [[ -e $release_tree ]]; then
			[[ -f $module_file || -f $module_file.xz ]] ||
				die "incomplete existing DKMS state for $release; refusing to overwrite it"
		else
			new_dkms_dirs+=("$release_tree")
		fi
		if [[ ! -f $module_file && -f $module_file.xz ]]; then
			xz -dk "$module_file.xz"
		fi
		if [[ -f $module_file ]]; then
			echo "Verifying existing DKMS build for $release"
		else
			echo "Prebuilding $module $module_version for $release in the installed DKMS tree"
			dkms build -m "$module" -v "$module_version" -k "$release/$arch" \
				--dkmstree "$dkms_tree" --sourcetree "$dkms_source_tree" \
				"${config_args[@]}" "${kernel_source_args[@]}"
			[[ -f $module_file ]] ||
				{ [[ -f $module_file.xz ]] && xz -dk "$module_file.xz"; }
		fi
		[[ -f $module_file ]] || die "prebuild produced no uncompressed module for $release"
		vermagic=$(modinfo -F vermagic "$module_file")
		[[ $vermagic == "$release"* ]] || die "wrong vermagic for $release: $vermagic"
		signer=$(modinfo -F signer "$module_file")
		sig_key=$(modinfo -F sig_key "$module_file")
		sig_id=$(modinfo -F sig_id "$module_file")
		[[ $signer == "$expected_signer" && -n $sig_key && -n $sig_id ]] ||
			die "signature metadata does not match the enrolled certificate for $release"
		continue
	fi
	dkms build -m "$module" -v "$module_version" -k "$release/$arch" \
		--dkmstree "$dkms_tree" --sourcetree "$dkms_source_tree" \
		"${config_args[@]}" "${kernel_source_args[@]}"
	module_file=$dkms_tree/$module/$module_version/$release/$arch/module/btrfs.ko
	if [[ ! -f $module_file && -f $module_file.xz ]]; then
		xz -dk "$module_file.xz"
	fi
	[[ -f $module_file ]] || die "DKMS did not produce an uncompressed module for $release"
	vermagic=$(modinfo -F vermagic "$module_file")
	[[ $vermagic == "$release"* ]] || die "wrong vermagic for $release: $vermagic"
	signer=$(modinfo -F signer "$module_file")
	sig_key=$(modinfo -F sig_key "$module_file")
	sig_id=$(modinfo -F sig_id "$module_file")
	[[ $signer == "$expected_signer" && -n $sig_key && -n $sig_id ]] ||
		die "signature metadata does not match the enrolled certificate for $release"
	mkdir -p "$install_tree/$release"
	dkms install -m "$module" -v "$module_version" -k "$release/$arch" \
		--dkmstree "$dkms_tree" --sourcetree "$dkms_source_tree" \
		--installtree "$install_tree" --no-depmod "${kernel_source_args[@]}"
	installed=$install_tree/$release/updates/dkms/btrfs.ko
	[[ -f $installed ]] || die "DKMS did not stage an installable module for $release"
	[[ $(modinfo -F vermagic "$installed") == "$release"* ]] ||
		die "staged module vermagic mismatch for $release"
	[[ $(modinfo -F signer "$installed") == "$expected_signer" ]] ||
		die "staged module signer mismatch for $release"
done

if [[ -n $prepare_dkms_tree ]]; then
	echo "Prepared signed DKMS module(s) for ${#kernels[@]} kernel release(s)."
	exit 0
fi

for release in "${kernels[@]}"; do
	archive=$output_dir/${module}-${module_version}-${release}-${timestamp}.tar
	work_archive=$work/$release.tar
	dkms mktarball -m "$module" -v "$module_version" -k "$release/$arch" \
		--dkmstree "$dkms_tree" --sourcetree "$dkms_source_tree" \
		--installtree "$install_tree" --archive "$work_archive" \
		"${kernel_source_args[@]}"
	tar -tf "$work_archive" > "$work/$release.files" ||
		die "DKMS archive validation failed for $release"
	grep -Fq "/$release/$arch/module/btrfs.ko.xz" "$work/$release.files" ||
		die "DKMS archive is missing the signed module for $release"
	mv -- "$work_archive" "$archive"
	archives+=("$archive")
done
echo "Verified signed modules for ${#kernels[@]} kernel release(s)."
printf 'DKMS archive: %s\n' "${archives[@]}"
